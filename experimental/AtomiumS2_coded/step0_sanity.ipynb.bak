{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "title",
   "metadata": {},
   "source": [
    "# step0 sanity: does the NFP solve reproduce its own data?\n",
    "\n",
    "`code.npy` and `prb.npy` come out of step0's near-field ptychography. The sharpest test of that\n",
    "solve is whether it reproduces the frames it was actually fitted to:\n",
    "\n",
    "    pdata[k]  ==  | D_nfp( prb * code_window(pos[k]) ) |^2\n",
    "\n",
    "one propagation at the CODE-plane geometry (voxelsize 42.12 nm, distance -18.00 mm), not the\n",
    "two-step code->sample->detector chain the holotomography side uses.\n",
    "\n",
    "Frames are picked to span **different regions of the aperture**, because that is the thing in\n",
    "question. With 324 positions, a 2048 px window and an 8192 px plane, the centre of the code is\n",
    "seen by nearly every position and the rim by very few -- so the code can be well reconstructed in\n",
    "the middle and unreliable at the edges, and a single frame cannot tell you which.\n",
    "\n",
    "**Positions matter and step0 currently discards them.** It saves only `code.npy` and `prb.npy`;\n",
    "`cl.vars['pos']` is thrown away after the solve. `data_nfp.h5`'s `shifts` are step0b's *starting*\n",
    "estimates, which the solver moves several px away from. Scoring at those stale shifts scores the\n",
    "model at positions the solver already rejected. This notebook uses `pos_nfp.npy` when present and\n",
    "warns loudly when it is not -- to produce it, add one line next to the saves in `step0.py`:\n",
    "\n",
    "    np.save(os.path.join(os.path.dirname(args.code_out), 'pos_nfp.npy'),\n",
    "            cp.asnumpy(cl.vars['pos']))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "paths",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Paths (hardcoded: this notebook does not read config_step0.conf)\n",
    "PATH_NFP  = '/data3/cekmekci/AtomiumS2_coded/nfp/data_nfp.h5'\n",
    "PATH_CODE = '/data3/cekmekci/AtomiumS2_coded/nfp/code.npy'\n",
    "PATH_PRB  = '/data3/cekmekci/AtomiumS2_coded/nfp/prb.npy'\n",
    "PATH_POS  = '/data3/cekmekci/AtomiumS2_coded/nfp/pos_nfp.npy'   # step0's refined positions, if saved\n",
    "\n",
    "N_SHOW = 9        # frames to inspect, spread over the aperture\n",
    "CROP   = 128      # px ignored at every edge; the modelled rim is unreliable"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "setup",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "using step0 REFINED positions from /data3/cekmekci/AtomiumS2_coded/nfp/pos_nfp.npy\n",
      "  they differ from step0b's by mean |dy| 3.791 px, mean |dx| 0.681 px\n",
      "\n",
      "324 positions, detector 2048x2048, code 8192^2\n",
      "distance -17.9961 mm   voxelsize 42.122 nm   shift span row [-2445,2446] col [-2609,2608] px\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/home/beams0/CEKMEKCI/Desktop/holotomocupy/src/holotomocupy/propagation.py:44: UserWarning: nvcc not found (NVCC='nvcc'). Set NVCC env var or add nvcc to PATH. Falling back to cuPy FFT.\n",
      "  self._use_cufftdx = cufftdx_available()\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import cupy as cp\n",
    "import h5py\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "from holotomocupy.propagation import Propagation\n",
    "\n",
    "with h5py.File(PATH_NFP, 'r') as f:\n",
    "    energy  = float(f['/exchange/energy'][0])\n",
    "    fdd     = float(f['/exchange/focusdetectordistance'][0])\n",
    "    z1      = float(f['/exchange/z1'][0])\n",
    "    vox     = float(f['/exchange/voxelsize'][0])\n",
    "    shifts  = f['/exchange/shifts'][:].astype('float32')\n",
    "    npos, nz, n = f['/exchange/pdata'].shape\n",
    "\n",
    "wavelength = 1.24e-9 / energy\n",
    "distance   = z1 * (fdd - z1) / fdd            # NEGATIVE: aperture upstream of the focus\n",
    "\n",
    "code_gpu = cp.asarray(np.load(PATH_CODE).astype('complex64'))\n",
    "prb_gpu  = cp.asarray(np.load(PATH_PRB).astype('complex64'))\n",
    "ncode = code_gpu.shape[0]\n",
    "Dnfp = Propagation(n, nz, 1, 1, wavelength, vox, [distance])\n",
    "\n",
    "# step0.py's own centring of the scan positions\n",
    "pos = shifts.copy()\n",
    "pos[:, 0] -= (pos[:, 0].max() + pos[:, 0].min()) / 2\n",
    "pos[:, 1] -= (pos[:, 1].max() + pos[:, 1].min()) / 2\n",
    "\n",
    "USING_REFINED = os.path.exists(PATH_POS)\n",
    "if USING_REFINED:\n",
    "    refined = np.load(PATH_POS).astype('float32')\n",
    "    if refined.shape == pos.shape:\n",
    "        moved = np.abs(refined - pos)\n",
    "        print(f'using step0 REFINED positions from {PATH_POS}')\n",
    "        print(f'  they differ from step0b\\'s by mean |dy| {moved[:,0].mean():.3f} px, '\n",
    "              f'mean |dx| {moved[:,1].mean():.3f} px')\n",
    "        pos = refined\n",
    "    else:\n",
    "        print(f'WARNING: {PATH_POS} has shape {refined.shape}, expected {pos.shape} -- ignoring')\n",
    "        USING_REFINED = False\n",
    "if not USING_REFINED:\n",
    "    print('=' * 78)\n",
    "    print('WARNING: no pos_nfp.npy. Falling back to step0b\\'s STARTING shifts.')\n",
    "    print('step0 refines the positions and discards them, so the model is being scored at')\n",
    "    print('positions the solver moved away from. Expect this to understate the fit quality;')\n",
    "    print('a poor result below is NOT conclusive until step0 saves its positions.')\n",
    "    print('=' * 78)\n",
    "\n",
    "print()\n",
    "print(f'{npos} positions, detector {nz}x{n}, code {ncode}^2')\n",
    "print(f'distance {distance*1e3:.4f} mm   voxelsize {vox*1e9:.3f} nm   '\n",
    "      f'shift span row [{pos[:,0].min():.0f},{pos[:,0].max():.0f}] '\n",
    "      f'col [{pos[:,1].min():.0f},{pos[:,1].max():.0f}] px')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cov-md",
   "metadata": {},
   "source": [
    "## Coverage: which parts of the aperture are actually constrained?\n",
    "\n",
    "Each position sees a 2048 px window of the 8192 px plane, centred at `ncode/2 - pos`. Counting how\n",
    "many windows cover each pixel shows directly where the code is over-determined and where it rests\n",
    "on a handful of frames. The frames inspected below are chosen to span this map rather than cluster\n",
    "in the well-covered middle."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "coverage",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "selected frames: [0, 8, 17, 144, 161, 171, 306, 315, 323]\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 750x700 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "coverage: max 62 windows, min 0, 27.2% of the plane seen by none\n"
     ]
    }
   ],
   "source": [
    "DS = 16                                    # downsample factor for the coverage map\n",
    "m = ncode // DS\n",
    "cov = np.zeros((m, m), dtype='int32')\n",
    "half = n // 2\n",
    "for k in range(npos):\n",
    "    r0 = int(round(ncode // 2 - pos[k, 0])) - half\n",
    "    c0 = int(round(ncode // 2 - pos[k, 1])) - half\n",
    "    cov[max(0, r0)//DS:(r0+n)//DS, max(0, c0)//DS:(c0+n)//DS] += 1\n",
    "\n",
    "# pick N_SHOW frames spanning the covered area: nearest to a 3x3 grid of targets\n",
    "ctr = np.stack([ncode/2 - pos[:, 0], ncode/2 - pos[:, 1]], axis=1)   # window centre of each frame\n",
    "lo, hi = ctr.min(0), ctr.max(0)\n",
    "targets = [(lo[0] + (hi[0]-lo[0])*a, lo[1] + (hi[1]-lo[1])*b)\n",
    "           for a in (0.0, 0.5, 1.0) for b in (0.0, 0.5, 1.0)][:N_SHOW]\n",
    "sel, used = [], set()\n",
    "for t in targets:\n",
    "    d = np.hypot(ctr[:, 0]-t[0], ctr[:, 1]-t[1])\n",
    "    for k in np.argsort(d):\n",
    "        if k not in used:\n",
    "            sel.append(int(k)); used.add(int(k)); break\n",
    "sel = sorted(sel)\n",
    "print('selected frames:', sel)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7.5, 7))\n",
    "im = ax.imshow(cov, cmap='viridis', extent=(0, ncode, ncode, 0))\n",
    "ax.scatter(ctr[:, 1], ctr[:, 0], s=6, c='white', alpha=0.35, label='all 324 window centres')\n",
    "ax.scatter(ctr[sel, 1], ctr[sel, 0], s=90, facecolors='none', edgecolors='red',\n",
    "           linewidths=1.8, label='inspected below')\n",
    "for k in sel:\n",
    "    ax.annotate(str(k), (ctr[k, 1], ctr[k, 0]), color='red', fontsize=8,\n",
    "                xytext=(6, 4), textcoords='offset points')\n",
    "ax.set(title='how many of the 324 windows cover each part of the aperture',\n",
    "       xlabel='code col [px]', ylabel='code row [px]')\n",
    "ax.legend(fontsize=8, loc='upper right'); fig.colorbar(im, ax=ax, fraction=0.046)\n",
    "plt.tight_layout(); plt.show()\n",
    "print(f'coverage: max {cov.max()} windows, min {cov.min()}, '\n",
    "      f'{100*(cov==0).mean():.1f}% of the plane seen by none')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fit-md",
   "metadata": {},
   "source": [
    "## Fit, frame by frame\n",
    "\n",
    "Measurement, model, and their plain **difference** -- no ratio, no normalisation. `pdata` is\n",
    "flat-normalised by step0b and the model is built from the same quantities step0 fitted, so both\n",
    "should already sit on the same scale; the two mean columns in the table say whether they do. If\n",
    "they disagree, that is itself a result and should not be hidden by rescaling.\n",
    "\n",
    "Measurement and model share one grey scale so a brightness mismatch is visible rather than\n",
    "normalised away. The difference is symmetric about zero, clipped at the 99th percentile of\n",
    "|difference|."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fit",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " frame        pos (row,col)    |pos|  cover  RMS(meas-model)  mean meas  mean model\n",
      "     0 ( -2282.6, +2340.9)     3270     19           0.0360     1.0672      1.0555\n",
      "     8 ( -2292.2,   +98.8)     2294     35           0.0331     1.0614      1.0552\n",
      "    17 ( -2445.4, -2487.3)     3488     16           0.0368     1.0562      1.0549\n",
      "   144 (  -168.3, +2608.4)     2614     23           0.0425     1.0383      1.0386\n",
      "   161 (  -204.0, -2554.6)     2563     27           0.0342     1.0358      1.0364\n",
      "   171 (   +66.0,   +66.4)       94     52           0.0309     1.0371      1.0364\n",
      "   306 ( +2393.2, -2391.5)     3383     15           0.0375     1.0282      1.0275\n",
      "   315 ( +2269.7,  +120.5)     2273     34           0.0340     1.0286      1.0257\n",
      "   323 ( +2271.3, +2416.4)     3316     18           0.0352     1.0268      1.0259\n",
      "\n",
      "RMS: min 0.0309  median 0.0352  max 0.0425\n",
      "absolute units -- pdata is flat-normalised so both sit near 1; compare the two mean columns\n",
      "to see whether model and measurement are even on the same scale.\n"
     ]
    }
   ],
   "source": [
    "c_ = (slice(CROP, nz - CROP), slice(CROP, n - CROP))\n",
    "G = 8   # guard band for the sub-pixel Fourier shift, so nothing wraps in\n",
    "\n",
    "\n",
    "def fshift(arr, dr, dc):\n",
    "    \"\"\"Sub-pixel Fourier shift of a complex array.\"\"\"\n",
    "    nr, nc = arr.shape\n",
    "    Fc, Fr = cp.meshgrid(cp.fft.fftfreq(nc).astype('float32'),\n",
    "                         cp.fft.fftfreq(nr).astype('float32'))\n",
    "    return cp.fft.ifft2(cp.fft.fft2(arr.astype('complex64'))\n",
    "                        * cp.exp(-2j * cp.pi * (Fr * dr + Fc * dc)).astype('complex64'))\n",
    "\n",
    "\n",
    "def model_at(k):\n",
    "    \"\"\"Model at pos[k], using its FULL sub-pixel value. pos[k] is the solver's own refined\n",
    "    position (float), not step0b's integer seed -- int(round(...)) alone was found to cost\n",
    "    ~19% RMS here, since it throws away exactly the sub-pixel refinement step0 solved for.\"\"\"\n",
    "    sy, sx = float(pos[k, 0]), float(pos[k, 1])\n",
    "    iy, ix = int(round(sy)), int(round(sx))\n",
    "    cr, cx = ncode // 2 - iy, ncode // 2 - ix\n",
    "    w = code_gpu[cr - nz // 2 - G: cr + nz // 2 + G, cx - n // 2 - G: cx + n // 2 + G]\n",
    "    w = fshift(w, dr=sy - iy, dc=sx - ix)[G:-G, G:-G]\n",
    "    return cp.abs(Dnfp.D(prb_gpu * w, 0)) ** 2\n",
    "\n",
    "\n",
    "rows = []\n",
    "store = {}\n",
    "with h5py.File(PATH_NFP, 'r') as f:\n",
    "    for k in sel:\n",
    "        meas = cp.asarray(f['/exchange/pdata'][k].astype('float32'))\n",
    "        mod = model_at(k)\n",
    "        dif = meas - mod                                    # plain difference, no normalisation\n",
    "        rms = float(cp.sqrt((dif[c_] ** 2).mean()))\n",
    "        cy, cx_ = ctr[k]\n",
    "        covk = int(cov[min(m - 1, int(cy) // DS), min(m - 1, int(cx_) // DS)])\n",
    "        rows.append((k, pos[k, 0], pos[k, 1], np.hypot(pos[k, 0], pos[k, 1]), covk,\n",
    "                     rms, float(meas[c_].mean()), float(mod[c_].mean())))\n",
    "        store[k] = (cp.asnumpy(meas), cp.asnumpy(mod), cp.asnumpy(dif))\n",
    "        del meas, mod, dif\n",
    "cp.get_default_memory_pool().free_all_blocks()\n",
    "\n",
    "print(f'{\"frame\":>6} {\"pos (row,col)\":>20} {\"|pos|\":>8} {\"cover\":>6} '\n",
    "      f'{\"RMS(meas-model)\":>16} {\"mean meas\":>10} {\"mean model\":>11}')\n",
    "for k, py, px, pr, covk, rms, mm, md_ in rows:\n",
    "    print(f'{k:6d} ({py:+8.1f},{px:+8.1f}) {pr:8.0f} {covk:6d} {rms:16.4f} {mm:10.4f} {md_:11.4f}')\n",
    "arr = np.array([(r[3], r[4], r[5]) for r in rows])\n",
    "print()\n",
    "print(f'RMS: min {arr[:,2].min():.4f}  median {np.median(arr[:,2]):.4f}  max {arr[:,2].max():.4f}')\n",
    "print('absolute units -- pdata is flat-normalised so both sit near 1; compare the two mean columns')\n",
    "print('to see whether model and measurement are even on the same scale.')\n",
    "if not USING_REFINED:\n",
    "    print('(remember: stale positions -- see the warning in the setup cell)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "montage",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x3960 with 54 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "nrow = len(sel)\n",
    "fig, ax = plt.subplots(nrow, 3, figsize=(14, 4.4 * nrow))\n",
    "for i, k in enumerate(sel):\n",
    "    meas, mod, dif = store[k]\n",
    "    lo_, hi_ = np.percentile(meas[c_], [1, 99])          # one scale for measurement AND model\n",
    "    v = np.percentile(np.abs(dif[c_]), 99)\n",
    "    for j, (img, t, kw) in enumerate((\n",
    "            (meas, f'frame {k}: measured', dict(cmap='gray', vmin=lo_, vmax=hi_)),\n",
    "            (mod, 'model', dict(cmap='gray', vmin=lo_, vmax=hi_)),\n",
    "            (dif, 'measured - model', dict(cmap='seismic', vmin=-v, vmax=v)))):\n",
    "        a = ax[i, j] if nrow > 1 else ax[j]\n",
    "        im = a.imshow(img, **kw)\n",
    "        a.set_title(f'{t}' + (f'   pos ({pos[k,0]:+.0f},{pos[k,1]:+.0f})' if j == 0 else ''),\n",
    "                    fontsize=9)\n",
    "        a.set_xticks([]); a.set_yticks([])\n",
    "        fig.colorbar(im, ax=a, fraction=0.046)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "sum-md",
   "metadata": {},
   "source": [
    "## Is the fit worse where the aperture is less covered?\n",
    "\n",
    "If the code is reconstructed reliably everywhere, RMS of the difference should be flat across\n",
    "positions. If it degrades with distance from the centre -- equivalently, with falling coverage --\n",
    "the solve is fine where the data constrains it and unreliable at the rim, and only the central\n",
    "region of `code.npy` should be trusted."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "summary",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "corr(RMS, distance from centre) = +0.571   (positive => worse further out)\n",
      "corr(RMS, coverage)             = -0.670   (negative => worse where fewer windows overlap)\n"
     ]
    }
   ],
   "source": [
    "fig, ax = plt.subplots(1, 2, figsize=(14, 5))\n",
    "ax[0].plot(arr[:, 0], arr[:, 2], 'ko')\n",
    "for (k, py, px, pr, covk, rms, mm, md_) in rows:\n",
    "    ax[0].annotate(str(k), (pr, rms), fontsize=8, xytext=(5, 3), textcoords='offset points')\n",
    "ax[0].set(xlabel='|pos| from the centre of the scan [px]', ylabel='RMS(meas - model)',\n",
    "          title='fit vs distance from the scan centre')\n",
    "ax[0].grid(alpha=0.3)\n",
    "\n",
    "ax[1].plot(arr[:, 1], arr[:, 2], 'ko')\n",
    "for (k, py, px, pr, covk, rms, mm, md_) in rows:\n",
    "    ax[1].annotate(str(k), (covk, rms), fontsize=8, xytext=(5, 3), textcoords='offset points')\n",
    "ax[1].set(xlabel=\"coverage: windows overlapping this frame's centre\", ylabel='RMS(meas - model)',\n",
    "          title='fit vs how well that region is constrained')\n",
    "ax[1].grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "if len(arr) > 2:\n",
    "    cr_ = np.corrcoef(arr[:, 0], arr[:, 2])[0, 1]\n",
    "    cv_ = np.corrcoef(arr[:, 1], arr[:, 2])[0, 1]\n",
    "    print(f'corr(RMS, distance from centre) = {cr_:+.3f}   (positive => worse further out)')\n",
    "    print(f'corr(RMS, coverage)             = {cv_:+.3f}   (negative => worse where fewer windows overlap)')"
   ]
  },
  {
