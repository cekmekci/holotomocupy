   "metadata": {},
   "source": [
    "# Are the coded-aperture positions right?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1a9985a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Paths (hardcoded: this notebook does not read config_steps15.conf)\n",
    "PATH_H5    = '/data3/cekmekci/AtomiumS2_coded/ht/codedHT.h5'\n",
    "PATH_H5_CA = '/data3/cekmekci/AtomiumS2_coded/nfp/data_nfp.h5'\n",
    "PATH_CODE  = '/data3/cekmekci/AtomiumS2_coded/nfp/code.npy'\n",
    "PATH_PRB   = '/data3/cekmekci/AtomiumS2_coded/nfp/prb.npy'\n",
    "OUT_DIR    = '/data3/cekmekci/AtomiumS2_coded/ht'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "setup",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pref0 (2048, 2048)  code 8192^2  detector 2048x2048\n",
      "distance 2.9432 mm   distance_code -3.4403 mm   voxelsize 7.001 nm\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/home/beams0/CEKMEKCI/Desktop/holotomocupy/src/holotomocupy/propagation.py:44: UserWarning: nvcc not found (NVCC='nvcc'). Set NVCC env var or add nvcc to PATH. Falling back to cuPy FFT.\n",
      "  self._use_cufftdx = cufftdx_available()\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import cupy as cp\n",
    "import h5py\n",
    "import matplotlib.pyplot as plt\n",
    "from holotomocupy.propagation import Propagation\n",
    "\n",
    "with h5py.File(PATH_H5, 'r') as f:\n",
    "    energy = float(f['/exchange/energy'][0])\n",
    "    det_px = float(f['/exchange/detector_pixelsize'][0])\n",
    "    fdd    = float(f['/exchange/focusdetectordistance'][0])\n",
    "    z1     = float(f['/exchange/z1'][0])\n",
    "    nz, n  = f['/exchange/pdata'].shape[1:]\n",
    "    pref0  = f['/exchange/pref0'][:].astype('float32')\n",
    "with h5py.File(PATH_H5_CA, 'r') as f:\n",
    "    z1_code = float(f['/exchange/z1'][0])\n",
    "\n",
    "wavelength = 1.24e-9 / energy\n",
    "distance   = z1 * (fdd - z1) / fdd\n",
    "voxelsize  = det_px / (fdd / z1)\n",
    "z2c        = z1 - z1_code\n",
    "norm_mag   = (z1 / z1_code) / (z1_code / z1)\n",
    "distance_code = (z1_code * z2c) / (z1_code + z2c) * norm_mag**2 * (z1_code / z1)**2\n",
    "\n",
    "code  = cp.asarray(np.load(PATH_CODE).astype('complex64'))\n",
    "prb   = cp.asarray(np.load(PATH_PRB).astype('complex64'))\n",
    "ncode = code.shape[0]\n",
    "D     = Propagation(n, nz, 1, 1, wavelength, voxelsize, [distance])\n",
    "Dcode = Propagation(n, nz, 1, 1, wavelength, voxelsize, [distance_code])\n",
    "\n",
    "print(f'pref0 {pref0.shape}  code {ncode}^2  detector {nz}x{n}')\n",
    "print(f'distance {distance*1e3:.4f} mm   distance_code {distance_code*1e3:.4f} mm   '\n",
    "      f'voxelsize {voxelsize*1e9:.3f} nm')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "find",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pref0 code shift: (-133, 235)\n"
     ]
    }
   ],
   "source": [
    "# Where does the code sit in pref0? Same recipe as step3: divide the probe envelope out,\n",
    "# pad to the code plane, correlate against the probe-free propagated code, take the argmax.\n",
    "ref = cp.abs(D.D(Dcode.D(prb, 0), 0)) ** 2                   # probe only, detector size\n",
    "P8  = Propagation(ncode, ncode, 1, 1, wavelength, voxelsize, [distance])\n",
    "P8c = Propagation(ncode, ncode, 1, 1, wavelength, voxelsize, [distance_code])\n",
    "cdata = cp.abs(P8.D(P8c.D(code, 0), 0)) ** 2                 # code only, 8192^2\n",
    "del P8, P8c\n",
    "cp.get_default_memory_pool().free_all_blocks()\n",
    "\n",
    "pad = (ncode - n) // 2\n",
    "rpad = cp.pad(cp.asarray(pref0) / (ref + 1e-6), ((pad, pad), (pad, pad)), constant_values=1)\n",
    "cc = cp.fft.fftshift(cp.fft.ifft2(cp.fft.fft2(cdata) * cp.conj(cp.fft.fft2(rpad))).real)\n",
    "iy, ix = (int(v.get()) for v in cp.unravel_index(cp.argmax(cc), cc.shape))\n",
    "sy, sx = -(iy - ncode // 2), -(ix - ncode // 2)\n",
    "del cc, rpad, cdata\n",
    "cp.get_default_memory_pool().free_all_blocks()\n",
    "print(f'pref0 code shift: ({sy}, {sx})')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "test",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "RMS |ratio - 1| = 0.0791   (0 = perfect)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1700x540 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Model at that shift, then divide. Perfect model -> ratio is 1 everywhere.\n",
    "cr, cx = ncode // 2 - sy, ncode // 2 - sx\n",
    "w = code[cr - nz // 2: cr + nz // 2, cx - n // 2: cx + n // 2]\n",
    "model = cp.abs(D.D(Dcode.D(prb * w, 0), 0)) ** 2\n",
    "\n",
    "CROP = 0                                                   # ignore the known-bad modelled rim\n",
    "sl = (slice(CROP, nz - CROP), slice(CROP, n - CROP))\n",
    "ratio = cp.asnumpy(cp.asarray(pref0) / (model + 1e-6))\n",
    "ratio /= np.median(ratio[sl])                                # only the SHAPE matters, not the scale\n",
    "print(f'RMS |ratio - 1| = {np.sqrt(((ratio[sl] - 1) ** 2).mean()):.4f}   (0 = perfect)')\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(17, 5.4))\n",
    "for a, img, t, kw in (\n",
    "        (ax[0], pref0[sl], 'pref0 measured (no sample)', {}),\n",
    "        (ax[1], cp.asnumpy(model)[sl], 'model at the fitted shift', {}),\n",
    "        (ax[2], ratio[sl], 'pref0 / model', dict(cmap='gray', vmin=0.6, vmax=1.4))):\n",
    "    if not kw:\n",
    "        lo, hi = np.percentile(img, [1, 99])\n",
    "        kw = dict(cmap='gray', vmin=lo, vmax=hi)\n",
    "    im = a.imshow(img, **kw); a.set_title(t, fontsize=10)\n",
    "    fig.colorbar(im, ax=a, fraction=0.046)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "align",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "8c316405927e49fc9c2911cd9020d17d",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "VBox(children=(HBox(children=(VBox(children=(HBox(children=(Label(value=' ', layout=Layout(width='46px')), But…"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- manual sub-pixel alignment -----------------------------------------------------------------\n",
    "# Arrow buttons nudge the code off the fitted integer shift; z1_code retunes the code->sample\n",
    "# distance; the window sliders choose which patch to inspect. Overview shows where the window is.\n",
    "# At full 2048 the code speckle is too fine to judge an alignment by eye, hence the zoom.\n",
    "import ipywidgets as W\n",
    "import cupyx.scipy.ndimage as cndi\n",
    "from IPython.display import display\n",
    "from matplotlib.patches import Rectangle\n",
    "\n",
    "CROP = 128                                     # unreliable modelled rim, excluded from the metric\n",
    "sl = (slice(CROP, nz - CROP), slice(CROP, n - CROP))\n",
    "G = 8\n",
    "\n",
    "\n",
    "def fshift(arr, dc, dr):\n",
    "    \"\"\"Sub-pixel Fourier shift of a complex array.\"\"\"\n",
    "    nr, nc = arr.shape\n",
    "    fr = cp.fft.fftfreq(nr).astype('float32')\n",
    "    fc = cp.fft.fftfreq(nc).astype('float32')\n",
    "    Fc, Fr = cp.meshgrid(fc, fr)\n",
    "    return cp.fft.ifft2(cp.fft.fft2(arr.astype('complex64'))\n",
    "                        * cp.exp(-2j * cp.pi * (Fr * dr + Fc * dc)).astype('complex64'))\n",
    "\n",
    "\n",
    "def set_distance(prop, dist):\n",
    "    \"\"\"Retune a Propagation in place. Only fker_x / fker_y depend on the distance -- the\n",
    "    pre-allocated buffer and the cuFFT plan do not -- so this is microseconds, not a rebuild.\n",
    "    Mirrors the constructor's own expressions exactly (propagation.py:30-40); verified to give\n",
    "    bit-identical kernels and bit-identical D() output against a freshly built Propagation.\"\"\"\n",
    "    fx = cp.fft.fftfreq(2 * prop.n, d=prop.voxelsize)\n",
    "    fy = cp.fft.fftfreq(2 * prop.nz, d=prop.voxelsize)\n",
    "    z = cp.asarray([dist])[:, None]\n",
    "    prop.fker_x = (cp.exp(-1j * cp.pi * prop.wavelength * z * fx[None, :] ** 2)\n",
    "                   / float(4 * prop.n * prop.nz)).astype('complex64')\n",
    "    prop.fker_y = cp.exp(-1j * cp.pi * prop.wavelength * z * fy[None, :] ** 2).astype('complex64')\n",
    "    prop.distance = [dist]\n",
    "\n",
    "\n",
    "def dcode_of(z1c):\n",
    "    \"\"\"distance_code for a given z1_code, same algebra as the setup cell.\"\"\"\n",
    "    z2c = z1 - z1c\n",
    "    nm = (z1 / z1c) / (z1c / z1)\n",
    "    return (z1c * z2c) / (z1c + z2c) * nm ** 2 * (z1c / z1) ** 2\n",
    "\n",
    "\n",
    "def model_at(dy, dx, z1c):\n",
    "    \"\"\"Model with the code nudged (dy, dx) px off the fitted shift, at code distance z1c.\"\"\"\n",
    "    set_distance(Dcode, dcode_of(z1c))\n",
    "    iy, ix = int(round(dy)), int(round(dx))\n",
    "    cr, cx = ncode // 2 - (sy + iy), ncode // 2 - (sx + ix)\n",
    "    w = code[cr - nz // 2 - G: cr + nz // 2 + G, cx - n // 2 - G: cx + n // 2 + G]\n",
    "    w = fshift(w, dc=dx - ix, dr=dy - iy)[G:-G, G:-G]\n",
    "    return cp.abs(D.D(Dcode.D(prb * w, 0), 0)) ** 2\n",
    "\n",
    "\n",
    "def ratio_rms(dy, dx, z1c):\n",
    "    \"\"\"(model, ratio, rms). Ratio is median-normalised over the usable frame so only its SHAPE\n",
    "    is judged -- pref0 is normalised to ~1, the model carries the NFP solve's own scale.\"\"\"\n",
    "    m = cp.asnumpy(model_at(dy, dx, z1c))\n",
    "    r = pref0 / (m + 1e-6)\n",
    "    r /= np.median(r[sl])\n",
    "    return m, r, float(np.sqrt(((r[sl] - 1) ** 2).mean()))\n",
    "\n",
    "\n",
    "ENT_RANGE, ENT_BINS = (0.5, 1.5), 256\n",
    "\n",
    "\n",
    "def entropy_of(v):\n",
    "    \"\"\"Shannon entropy of the ratio histogram over a FIXED range, so values are comparable\n",
    "    across settings. LOWER IS BETTER: a perfect division is a delta spike at 1.0, i.e. all mass\n",
    "    in one bin and entropy -> 0; residue spreads the distribution and raises it. Same direction\n",
    "    step7.py uses (\"negative is better\" against no correction).\n",
    "\n",
    "    Caveat worth knowing: a sinusoidal, code-like residue has a bimodal (arcsine) histogram\n",
    "    concentrated at its extremes, so entropy under-reacts to it -- 15% sinusoid scores LOWER\n",
    "    than 5% gaussian noise. Read it next to the RMS, not instead of it.\"\"\"\n",
    "    h, _ = np.histogram(np.clip(v, *ENT_RANGE), bins=ENT_BINS, range=ENT_RANGE)\n",
    "    p = h / h.sum()\n",
    "    p = p[p > 0]\n",
    "    return float(-(p * np.log(p)).sum()), h\n",
    "\n",
    "\n",
    "# --- state + cache: moving the window must NOT recompute the model ------------------------------\n",
    "st = {'dy': 0.0, 'dx': 0.0}\n",
    "_cache = {'key': None}\n",
    "\n",
    "\n",
    "def current():\n",
    "    key = (st['dy'], st['dx'], w_zc.value)\n",
    "    if _cache['key'] != key:\n",
    "        m, r, rms = ratio_rms(st['dy'], st['dx'], w_zc.value * 1e-3)\n",
    "        _cache.update(key=key, m=m, r=r, rms=rms)\n",
    "    return _cache['m'], _cache['r'], _cache['rms']\n",
    "\n",
    "\n",
    "# --- controls -----------------------------------------------------------------------------------\n",
    "_bl = W.Layout(width='46px')\n",
    "w_step = W.Dropdown(options=[0.05, 0.1, 0.25, 0.5, 1.0], value=0.25,\n",
    "                    description='step px', layout=W.Layout(width='180px'))\n",
    "w_zc = W.FloatSlider(value=z1_code * 1e3, min=z1_code * 1e3 * 1.25, max=z1_code * 1e3 * 0.75,\n",
    "                     step=0.05, description='z1_code mm', readout_format='.3f',\n",
    "                     continuous_update=False, layout=W.Layout(width='430px'))\n",
    "w_size = W.Dropdown(options=[128, 256, 384, 512], value=256,\n",
    "                    description='win', layout=W.Layout(width='160px'))\n",
    "w_row = W.IntSlider(value=160, min=0, max=nz - 128, step=16, description='win row',\n",
    "                    continuous_update=False, layout=W.Layout(width='430px'))\n",
    "w_col = W.IntSlider(value=n - 256 - 160, min=0, max=n - 128, step=16, description='win col',\n",
    "                    continuous_update=False, layout=W.Layout(width='430px'))\n",
    "w_cmap = W.Dropdown(options=['seismic', 'berlin', 'RdBu_r', 'bwr', 'coolwarm', 'PuOr_r', 'gray'],\n",
    "                    value='seismic', description='cmap', layout=W.Layout(width='200px'))\n",
    "w_vr = W.FloatLogSlider(value=0.4, base=10, min=-2.3, max=-0.2, step=0.05,\n",
    "                        description='+-range', readout_format='.3f',\n",
    "                        continuous_update=False, layout=W.Layout(width='330px'))\n",
    "w_hp = W.Checkbox(value=False, description='high-pass', indent=False,\n",
    "                  layout=W.Layout(width='130px'))\n",
    "w_lbl = W.HTML()\n",
    "w_out = W.Output()\n",
    "\n",
    "\n",
    "def _win():\n",
    "    \"\"\"Clamp the chosen window to the frame.\"\"\"\n",
    "    s = w_size.value\n",
    "    r0 = int(np.clip(w_row.value, 0, nz - s))\n",
    "    c0 = int(np.clip(w_col.value, 0, n - s))\n",
    "    return r0, c0, s\n",
    "\n",
    "\n",
    "def redraw(_=None):\n",
    "    m, r, rms = current()\n",
    "    r0, c0, s = _win()\n",
    "    win = (slice(r0, r0 + s), slice(c0, c0 + s))\n",
    "\n",
    "    rv = r\n",
    "    if w_hp.value:                             # remove the slow background; keeps centre at 1\n",
    "        g = cp.asarray(r)\n",
    "        rv = cp.asnumpy(g - cndi.gaussian_filter(g, 16.0)) + 1.0\n",
    "\n",
    "    ent, hist = entropy_of(rv[sl])\n",
    "    w_lbl.value = (f\"<b>offset ({st['dy']:+.2f}, {st['dx']:+.2f}) px &nbsp;&nbsp; \"\n",
    "                   f\"z1_code {w_zc.value:.3f} mm &nbsp;&nbsp; RMS |ratio-1| = {rms:.4f}\"\n",
    "                   f\" &nbsp;&nbsp; entropy = {ent:.4f}</b>\"\n",
    "                   f\" &nbsp; <i>both LOWER = flatter = better; measured over the full frame, \"\n",
    "                   f\"not the window. nominal z1_code {z1_code * 1e3:.3f} mm; \"\n",
    "                   f\"window {s}x{s} at row {r0}, col {c0}</i>\")\n",
    "    ms = np.median(r[sl])\n",
    "    vr = w_vr.value\n",
    "    with w_out:\n",
    "        w_out.clear_output(wait=True)\n",
    "        fig, ax = plt.subplots(1, 5, figsize=(26, 5.2))\n",
    "\n",
    "        ov = pref0[::4, ::4]\n",
    "        lo_o, hi_o = np.percentile(ov, [1, 99])\n",
    "        ax[0].imshow(ov, cmap='gray', vmin=lo_o, vmax=hi_o, extent=(0, n, nz, 0))\n",
    "        ax[0].add_patch(Rectangle((c0, r0), s, s, fill=False, ec='red', lw=2))\n",
    "        ax[0].add_patch(Rectangle((CROP, CROP), n - 2 * CROP, nz - 2 * CROP,\n",
    "                                  fill=False, ec='yellow', lw=0.8, ls='--'))\n",
    "        ax[0].set_title('pref0 full frame\\nred = window, yellow = metric region', fontsize=9)\n",
    "\n",
    "        lo, hi = np.percentile(pref0[win], [1, 99])\n",
    "        for a, img, t in ((ax[1], pref0[win], 'pref0 measured'),\n",
    "                          (ax[2], m[win] * ms, 'model at this shift')):\n",
    "            im = a.imshow(img, cmap='gray', vmin=lo, vmax=hi)\n",
    "            a.set_title(t, fontsize=10); fig.colorbar(im, ax=a, fraction=0.046)\n",
    "\n",
    "        im = ax[3].imshow(rv[win], cmap=w_cmap.value, vmin=1 - vr, vmax=1 + vr)\n",
    "        ax[3].set_title(f'{\"high-passed \" if w_hp.value else \"\"}pref0 / model   '\n",
    "                        f'(+-{vr:.3f})', fontsize=10)\n",
    "        fig.colorbar(im, ax=ax[3], fraction=0.046)\n",
    "        for a in ax[1:4]:\n",
    "            a.set_xticks([]); a.set_yticks([])\n",
    "\n",
    "        edges = np.linspace(*ENT_RANGE, ENT_BINS + 1)\n",
    "        ax[4].bar(0.5 * (edges[1:] + edges[:-1]), hist, width=edges[1] - edges[0],\n",
    "                  color='k', log=True)\n",
    "        ax[4].axvline(1.0, color='g', ls='--', lw=1, label='perfect = 1.0')\n",
    "        ax[4].axvspan(1 - vr, 1 + vr, color='orange', alpha=0.15, label='displayed range')\n",
    "        ax[4].set(xlabel='ratio', ylabel='count (log)', xlim=ENT_RANGE,\n",
    "                  title=f'histogram over the metric region\\nentropy {ent:.4f}  '\n",
    "                        f'(lower = flatter)')\n",
    "        ax[4].legend(fontsize=8); ax[4].grid(alpha=0.3)\n",
    "        plt.tight_layout(); plt.show(); plt.close(fig)\n",
    "\n",
    "\n",
    "def nudge(ddy, ddx):\n",
    "    def handler(_):\n",
    "        st['dy'] += ddy * w_step.value\n",
    "        st['dx'] += ddx * w_step.value\n",
    "        redraw()\n",
    "    return handler\n",
    "\n",
    "\n",
    "def reset(_):\n",
    "    st['dy'] = st['dx'] = 0.0\n",
    "    w_zc.value = z1_code * 1e3\n",
    "    redraw()\n",
    "\n",
    "\n",
    "b_up, b_dn = W.Button(description='^', layout=_bl), W.Button(description='v', layout=_bl)\n",
    "b_lf, b_rt = W.Button(description='<', layout=_bl), W.Button(description='>', layout=_bl)\n",
    "b_rs = W.Button(description='reset', layout=W.Layout(width='70px'))\n",
    "b_up.on_click(nudge(-1, 0)); b_dn.on_click(nudge(+1, 0))\n",
    "b_lf.on_click(nudge(0, -1)); b_rt.on_click(nudge(0, +1))\n",
    "b_rs.on_click(reset)\n",
    "for _w in (w_zc, w_size, w_row, w_col, w_cmap, w_vr, w_hp):\n",
    "    _w.observe(redraw, names='value')\n",
    "\n",
    "display(W.VBox([\n",
    "    W.HBox([W.VBox([W.HBox([W.Label(' ', layout=_bl), b_up]),\n",
    "                    W.HBox([b_lf, b_dn, b_rt])]),\n",
    "            W.VBox([w_step, b_rs]), W.VBox([w_size])]),\n",
    "    w_zc, W.HBox([w_row, w_col]), W.HBox([w_cmap, w_vr, w_hp]), w_lbl, w_out]))\n",
    "redraw()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "zcsweep",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "offset held at (+0.00, +0.00) px\n",
      "nominal  z1_code  -17.750 mm  ->  RMS 0.0659\n",
      "best     z1_code  -17.750 mm  ->  RMS 0.0659   (+0.0%)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x500 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- z1_code sweep ------------------------------------------------------------------------------\n",
    "# z1_code enters the model only through distance_code, i.e. how much the aperture blurs on its way\n",
    "# from the code plane to the sample plane. If the nominal -17.75 mm is wrong, the modelled code is\n",
    "# sharper or softer than the measured one and no shift can fix it. Swept at the offset the widget\n",
    "# above is currently showing, so nudge it to your best alignment first.\n",
    "ZC_SPAN, ZC_N = 0.35, 29                     # +- fraction of z1_code, points\n",
    "zc_vals = z1_code * np.linspace(1 - ZC_SPAN, 1 + ZC_SPAN, ZC_N)\n",
    "zc_rms = np.array([ratio_rms(st['dy'], st['dx'], z)[2] for z in zc_vals])\n",
    "\n",
    "i_best = int(zc_rms.argmin())\n",
    "i_nom = int(np.abs(zc_vals - z1_code).argmin())\n",
    "print(f\"offset held at ({st['dy']:+.2f}, {st['dx']:+.2f}) px\")\n",
    "print(f'nominal  z1_code {z1_code * 1e3:8.3f} mm  ->  RMS {zc_rms[i_nom]:.4f}')\n",
    "print(f'best     z1_code {zc_vals[i_best] * 1e3:8.3f} mm  ->  RMS {zc_rms[i_best]:.4f}'\n",
    "      f'   ({100 * (zc_rms[i_best] / zc_rms[i_nom] - 1):+.1f}%)')\n",
    "if i_best in (0, ZC_N - 1):\n",
    "    print('  WARNING: minimum is on the edge of the swept range -- widen ZC_SPAN')\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(14, 5))\n",
    "ax[0].plot(zc_vals * 1e3, zc_rms, 'k.-', lw=1)\n",
    "ax[0].axvline(z1_code * 1e3, color='g', ls='--', lw=1, label=f'nominal {z1_code*1e3:.2f} mm')\n",
    "ax[0].axvline(zc_vals[i_best] * 1e3, color='r', ls=':', lw=1,\n",
    "              label=f'best {zc_vals[i_best]*1e3:.2f} mm')\n",
    "ax[0].set(xlabel='z1_code [mm]', ylabel='RMS |ratio - 1|', title='sample-free fit vs code distance')\n",
    "ax[0].legend(fontsize=8); ax[0].grid(alpha=0.3)\n",
    "\n",
    "_, r_best, _ = ratio_rms(st['dy'], st['dx'], zc_vals[i_best])\n",
    "_r0, _c0, _s = _win()\n",
    "im = ax[1].imshow(r_best[_r0:_r0+_s, _c0:_c0+_s], cmap='RdBu_r', vmin=0.6, vmax=1.4)\n",
    "ax[1].set_xticks([]); ax[1].set_yticks([])\n",
    "ax[1].set_title(f'ratio at best z1_code = {zc_vals[i_best]*1e3:.3f} mm  ({_s}x{_s} window)', fontsize=10)\n",
    "fig.colorbar(im, ax=ax[1], fraction=0.046)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "set_distance(Dcode, dcode_of(z1_code))       # leave the propagator back at nominal\n",
    "cp.get_default_memory_pool().free_all_blocks()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "probe-md",
   "metadata": {},
   "source": [
    "## Sanity check: pref0, the propagated probe, the propagated code, and the division\n",
    "\n",
    "`pref0` has no sample. The probe-only flat is `|D(D_code(prb))|^2` -- probe propagated to the\n",
    "detector with no aperture and no sample. Dividing one by the other should leave the bare code,\n",
    "which can then be compared against the code propagated on its own, `|D(D_code(code_window))|^2`.\n",
    "If the code does not come out clearly, or comes out with the wrong contrast, the probe is suspect.\n",
    "\n",
    "Worth knowing while reading it: propagation does not commute with multiplication, so\n",
    "`|D(D_code(prb*code))|^2` is not exactly `|D(D_code(prb))|^2 * |D(D_code(code))|^2`. The\n",
    "factorisation this comparison rests on is an approximation, so some difference is expected even\n",
    "with a perfect probe. A large or structured difference is the thing to care about."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "probe-check",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pref0            mean 1.0000   std/mean 0.5011\n",
      "propagated probe mean 1.0525   std/mean 0.4472\n",
      "pref0 / probe              std/mean 0.2794\n",
      "propagated code            std/mean 0.2194    contrast ratio 1.2734\n",
      "difference  RMS 0.1829   ptp 6.3673   correlation 0.7592\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2700x580 with 10 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- pref0, propagated probe, their division, propagated code, and the difference ---------------\n",
    "ref_probe = cp.abs(D.D(Dcode.D(prb, 0), 0)) ** 2                 # probe only: no code, no sample\n",
    "cr, cx = ncode // 2 - sy, ncode // 2 - sx\n",
    "w_code = code[cr - nz // 2: cr + nz // 2, cx - n // 2: cx + n // 2]\n",
    "prop_code = cp.asnumpy(cp.abs(D.D(Dcode.D(w_code, 0), 0)) ** 2)  # code only: no probe\n",
    "\n",
    "rp  = cp.asnumpy(ref_probe)\n",
    "div = cp.asnumpy(cp.asarray(pref0) / (ref_probe + 1e-6))\n",
    "\n",
    "c_ = (slice(128, nz - 128), slice(128, n - 128))                 # drop the unreliable rim\n",
    "a_ = div / np.median(div[c_])                                    # pref0 / probe, normalised\n",
    "b_ = prop_code / np.median(prop_code[c_])                        # propagated code, normalised\n",
    "d_ = a_ - b_\n",
    "\n",
    "print(f'pref0            mean {pref0.mean():.4f}   std/mean {pref0.std()/pref0.mean():.4f}')\n",
    "print(f'propagated probe mean {rp.mean():.4f}   std/mean {rp.std()/rp.mean():.4f}')\n",
    "print(f'pref0 / probe              std/mean {a_[c_].std():.4f}')\n",
    "print(f'propagated code            std/mean {b_[c_].std():.4f}'\n",
    "      f'    contrast ratio {a_[c_].std()/b_[c_].std():.4f}')\n",
    "x_ = a_[c_] - a_[c_].mean(); y_ = b_[c_] - b_[c_].mean()\n",
    "print(f'difference  RMS {np.sqrt((d_[c_]**2).mean()):.4f}   ptp {np.ptp(d_[c_]):.4f}'\n",
    "      f'   correlation {float((x_*y_).mean()/(np.sqrt((x_*x_).mean())*np.sqrt((y_*y_).mean()))):.4f}')\n",
    "\n",
    "fig, ax = plt.subplots(1, 5, figsize=(27, 5.8))\n",
    "for a, img, t in ((ax[0], pref0, 'pref0 (measured, no sample)'),\n",
    "                  (ax[1], rp,    'propagated probe\\n|D(D_code(prb))|^2')):\n",
    "    lo, hi = np.percentile(img, [1, 99])\n",
    "    im = a.imshow(img, cmap='gray', vmin=lo, vmax=hi)\n",
    "    a.set_title(t, fontsize=10); fig.colorbar(im, ax=a, fraction=0.046)\n",
    "lo, hi = np.percentile(a_, [1, 99])                               # shared scale for the two codes\n",
    "for a, img, t in ((ax[2], a_, 'pref0 / propagated probe'),\n",
    "                  (ax[3], b_, 'propagated code\\n|D(D_code(code))|^2')):\n",
    "    im = a.imshow(img, cmap='gray', vmin=lo, vmax=hi)\n",
    "    a.set_title(t, fontsize=10); fig.colorbar(im, ax=a, fraction=0.046)\n",
    "v = np.percentile(np.abs(d_), 99)\n",
    "im = ax[4].imshow(d_, cmap='seismic', vmin=-v, vmax=v)\n",
    "ax[4].set_title('difference\\n(pref0/probe) - (propagated code)', fontsize=10)\n",
    "fig.colorbar(im, ax=ax[4], fraction=0.046)\n",
    "plt.tight_layout(); plt.show()\n",
    "cp.get_default_memory_pool().free_all_blocks()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e0150668",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "nfp-md",
   "metadata": {},
   "source": [
    "## NFP self-consistency test -- BLOCKED, needs step0 to save its positions\n",
    "\n",
    "The test we want is whether `code.npy` and `prb.npy` reproduce the data they were fitted to:\n",
    "\n",
    "    pdata[k]  ==  | D_nfp( prb * code_window(pos[k]) ) |^2\n",
    "\n",
    "It cannot be run with what is on disk. `step0.py` refines `pos` during the solve and then\n",
    "**discards it** -- it saves only `code.npy` and `prb.npy` and logs the mean change\n",
    "(`mean |dy| 4.410 px, mean |dx| 0.873 px`). `data_nfp.h5`'s `shifts` are step0b's *starting*\n",
    "estimates, several px from where the solver ended up, and no `.h5` checkpoint was written\n",
    "(`checkpoints_tiff/` holds only `prb####.npy`), so the refined positions exist nowhere.\n",
    "\n",
    "Scoring the model at the stale nominal shifts is not the test -- it scores the model at positions\n",
    "the solver had already rejected. Re-fitting a shift per frame by cross-correlating measurement\n",
    "against model is not the test either: it fits the quantity under examination, so genuine\n",
    "code/probe error gets absorbed as a fake position shift, and it is a per-frame estimator where\n",
    "step0 solved all 324 positions jointly with the code and probe.\n",
    "\n",
    "**To unblock:** add one line to `step0.py` next to the existing saves,\n",
    "\n",
    "    np.save(os.path.join(os.path.dirname(args.code_out), 'pos_nfp.npy'),\n",
    "            cp.asnumpy(cl.vars['pos']))\n",
    "\n",
    "then re-run step0 and bring the test back using those positions. Cheap, and it also makes the\n",
    "convergence question directly answerable instead of inferred from a log."
   ]
  }
 ],
